      },
      {
        "fieldName": "hiring_signal",
        "label": "Hiring Signal",
        "propertyType": "string"
      },
      {
        "fieldName": "success",
        "label": "Success",
        "propertyType": "boolean"
      },
      {
        "fieldName": "error_message",
        "label": "Error Message",
        "propertyType": "string"
      }
    ],
    "labels": {
