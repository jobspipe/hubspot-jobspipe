{
  "name": "jobspipe-hubspot-app",
  "version": "1.0.0",
  "description": "HubSpot app integration with JobsPipe hiring intelligence API",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.{js,jsx,json}' 'tests/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/jobspipe-hubspot-app.git"
  },
  "keywords": [
    "hubspot",
    "jobspipe",
    "hiring",
    "recruitment",
    "crm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "@hubspot/api-client": "^11.0.0",
    "@hubspot/ui-extensions": "^1.0.0",
    "axios": "^1.6.0",
    "react": "^18.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
